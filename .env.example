# ==============================================================================
# PASSENGER MANAGER - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your values

# --- SYSTEM PROFILE ---
# Adjusts resource usage based on fleet size
# Options: Small (1-300 vehicles), Medium (300-1000 vehicles), Large (1000+ vehicles)
SYSTEM_PROFILE=Medium

# --- APPLICATION ---
APP_PORT=8080

# --- DATABASE (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=PassengerManagerDB

# ==============================================================================