<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="ColorBase">#041D40</Color>
    <Color x:Key="ColorBlueDark">#0A4DA6</Color>
    <Color x:Key="ColorBlue">#0B7ABF</Color>
    <Color x:Key="ColorBlueLight">#63A5BF</Color>
    <Color x:Key="ColorWhite">#FFFFFF</Color>
    <Color x:Key="ColorGray">#CEECF2</Color>
    <Color x:Key="ColorRed">#DC2626</Color>
    <Color x:Key="ColorOrange">#C2410C</Color>
    <Color x:Key="ColorGreen">#0E9F6E</Color>

    <SolidColorBrush x:Key="BrushBase" Color="{StaticResource ColorBase}"/>
    <SolidColorBrush x:Key="BrushBlueDark" Color="{StaticResource ColorBlueDark}"/>
    <SolidColorBrush x:Key="BrushBlue" Color="{StaticResource ColorBlue}"/>
    <SolidColorBrush x:Key="BrushBlueLight" Color="{StaticResource ColorBlueLight}"/>
    <SolidColorBrush x:Key="BrushWhite" Color="{StaticResource ColorWhite}"/>
    <SolidColorBrush x:Key="BrushGray" Color="{StaticResource ColorGray}"/>
    <SolidColorBrush x:Key="BrushRed" Color="{StaticResource ColorRed}"/>
    <SolidColorBrush x:Key="BrushOrange" Color="{StaticResource ColorOrange}"/>
    <SolidColorBrush x:Key="BrushGreen" Color="{StaticResource ColorGreen}"/>
</ResourceDictionary>