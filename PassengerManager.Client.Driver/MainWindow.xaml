<Window x:Class="PassengerManager.Client.Driver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:PassengerManager.Client.Driver.ViewModels"
        xmlns:views="clr-namespace:PassengerManager.Client.Driver.Views"
        xmlns:controls="clr-namespace:PassengerManager.Client.Driver.Controls"
        Title="Terminal"
        WindowState="Maximized"
        WindowStyle="None"
        Background="#121212">
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:DriverLoginViewModel}">
            <views:DriverLoginView />
        </DataTemplate>
    </Window.Resources>    
    <Viewbox Stretch="Uniform" StretchDirection="Both">
        <Grid Width="1920" Height="1080">
            <!-- Main content area -->
            <ContentControl Content="{Binding CurrentViewModel}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"/>

            <!-- Overlay panel with SOS button and other always-visible UI elements -->
            <Canvas Panel.ZIndex="1000" IsHitTestVisible="True">
                <!-- SOS Button in bottom-left corner -->
                <controls:HoldToActivateButton Canvas.Left="20" Canvas.Bottom="20"
                                               Width="140" Height="140"
                                               Style="{StaticResource SosButtonStyle}"
                                               HoldCompletedCommand="{Binding EmergencySosCommand}"
                                               ToolTip="Hold for Emergency SOS">
                    <TextBlock Text="SOS" TextAlignment="Center"/>
                </controls:HoldToActivateButton>
            </Canvas>
        </Grid>
    </Viewbox>
</Window>
