<Window x:Class="PassengerManager.Client.Driver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:PassengerManager.Client.Driver.ViewModels"
        xmlns:viewmodelsoverlay="clr-namespace:PassengerManager.Client.Driver.ViewModels.Overlay"
        xmlns:views="clr-namespace:PassengerManager.Client.Driver.Views"
        xmlns:viewsoverlay="clr-namespace:PassengerManager.Client.Driver.Views.Overlay"
        xmlns:controls="clr-namespace:PassengerManager.Client.Driver.Controls"
        Title="Terminal"
        WindowState="Maximized"
        WindowStyle="None"
        Background="#121212">

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:DriverLoginViewModel}">
            <views:DriverLoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodelsoverlay:SideBarViewModel}">
            <viewsoverlay:SideBarView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodelsoverlay:StatusBarViewModel}">
            <viewsoverlay:StatusBarView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <ContentControl />
    </Grid>
</Window>