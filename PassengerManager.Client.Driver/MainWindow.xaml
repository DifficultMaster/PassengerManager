<Window x:Class="PassengerManager.Client.Driver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PassengerManager.Client.Driver.ViewModels"
        xmlns:vmdashboard ="clr-namespace:PassengerManager.Client.Driver.ViewModels.Dashboard"
        xmlns:vmoverlay="clr-namespace:PassengerManager.Client.Driver.ViewModels.Overlay"
        xmlns:views="clr-namespace:PassengerManager.Client.Driver.Views"
        xmlns:viewsdashboard="clr-namespace:PassengerManager.Client.Driver.Views.Dashboard"
        xmlns:viewsoverlay="clr-namespace:PassengerManager.Client.Driver.Views.Overlay"
        xmlns:controls="clr-namespace:PassengerManager.Client.Driver.Controls"
        xmlns:stores="clr-namespace:PassengerManager.Client.Driver.Stores"
        Title="Terminal"
        WindowState="Maximized"
        WindowStyle="None"
        Background="{StaticResource BrushBase}"
        mc:Ignorable="d" d:DesignHeight="1080" d:DesignWidth="1920"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/OverlayStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate DataType="{x:Type vm:DriverLoginViewModel}">
                <views:DriverLoginView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmoverlay:SideBarViewModel}">
                <viewsoverlay:SideBarView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmoverlay:StatusBarViewModel}">
                <viewsoverlay:StatusBarView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmdashboard:RouteSelectionViewModel}">
                <viewsdashboard:RouteSelectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmdashboard:TripSelectionViewModel}">
                <viewsdashboard:TripSelectionView />
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Border BorderThickness="8" Panel.ZIndex="101">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.SideBarStore.IsEmergency, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource BrushRed}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <Viewbox Stretch="Uniform">
            <Grid Width="1920" Height="1080">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ContentPresenter Content="{Binding DataContext.CurrentViewModel, RelativeSource={RelativeSource AncestorType=Window}}">
                        <ContentPresenter.Style>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Grid.Column" Value="1"/>
                                <Setter Property="Grid.ColumnSpan" Value="1"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SideBarStore.IsOverlay, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Grid.Column" Value="0"/>
                                        <Setter Property="Grid.ColumnSpan" Value="2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentPresenter.Style>
                    </ContentPresenter>

                    <viewsoverlay:SideBarView Grid.Column="0" Panel.ZIndex="10"
                                              DataContext="{Binding DataContext.SideBarViewModel, RelativeSource={RelativeSource AncestorType=Window}}">
                        <viewsoverlay:SideBarView.Style>
                            <Style TargetType="viewsoverlay:SideBarView">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SideBarStore.IsOverlay, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </viewsoverlay:SideBarView.Style>
                    </viewsoverlay:SideBarView>

                    <viewsoverlay:SideBarView Grid.ColumnSpan="2" Panel.ZIndex="15"
                                              HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                              DataContext="{Binding DataContext.SideBarViewModel, RelativeSource={RelativeSource AncestorType=Window}}">
                        <viewsoverlay:SideBarView.Style>
                            <Style TargetType="viewsoverlay:SideBarView">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SideBarStore.IsOverlay, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </viewsoverlay:SideBarView.Style>
                    </viewsoverlay:SideBarView>

                    <controls:HoldToActivateButton Grid.Column="0" Grid.RowSpan="2" 
                                                   Panel.ZIndex="30"
                                                   Width="128" Height="128" FontSize="56"
                                                   Content="SOS"
                                                   HoldDuration="0:0:3"
                                                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                   Command="{Binding DataContext.SideBarViewModel.InitiateEmergencyCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <controls:HoldToActivateButton.Style>
                            <Style TargetType="controls:HoldToActivateButton" BasedOn="{StaticResource SosCircularStyle}">
                                <Setter Property="Margin" Value="0,0,0,40"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SideBarStore.IsOverlay, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                 Value="True">
                                        <Setter Property="Margin" Value="40,0,0,40"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:HoldToActivateButton.Style>
                    </controls:HoldToActivateButton>
                </Grid>
                <viewsoverlay:StatusBarView VerticalAlignment="Top" Panel.ZIndex="20"
                                            DataContext="{Binding DataContext.StatusBarViewModel, RelativeSource={RelativeSource AncestorType=Window}}">
                    <viewsoverlay:StatusBarView.Style>
                        <Style TargetType="viewsoverlay:StatusBarView">
                            <Setter Property="Margin" Value="80,16,80,0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.SideBarStore.IsOverlay, RelativeSource={RelativeSource AncestorType=Window}}" 
                                             Value="False">
                                    <Setter Property="Margin" Value="288,16,80,0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </viewsoverlay:StatusBarView.Style>
                </viewsoverlay:StatusBarView>
            </Grid>
        </Viewbox>
    </Grid>
</Window>