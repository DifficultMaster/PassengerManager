<UserControl x:Class="PassengerManager.Client.Driver.Views.Dashboard.TripSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PassengerManager.Client.Driver.Views.Dashboard"
             xmlns:vm="clr-namespace:PassengerManager.Client.Driver.ViewModels.Dashboard"
             mc:Ignorable="d" Background="{x:Null}"
             d:DesignHeight="1080" d:DesignWidth="1712" 
             d:DataContext="{d:DesignInstance Type=vm:TripSelectionViewModel, IsDesignTimeCreatable=False}">
    <Border Margin="76,130,80,90" Background="{StaticResource BrushBlue}" CornerRadius="30">
        <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
            <StackPanel Margin="60,30,60,30">
                <Button Command="{Binding GoBackCommand}"
                        Style="{StaticResource BackButtonStyle}"
                        Width="NaN" Height="Auto" MinHeight="140"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,30">
                    <TextBlock Text="{Binding GoBackButtonText}" 
                               TextWrapping="Wrap" 
                               TextAlignment="Center" 
                               FontSize="56" FontFamily="Noto Sans JP" FontWeight="SemiBold"
                               Margin="30"/>
                </Button>
                <ItemsControl ItemsSource="{Binding Trips}" HorizontalAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.SelectTripCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource TileButtonStyle}"
                                    Width="NaN" Height="Auto" MinHeight="140"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,15">
                                <TextBlock Text="{Binding Headsign}" 
                                           TextWrapping="Wrap" 
                                           TextAlignment="Center" 
                                           FontSize="56" FontFamily="Noto Sans JP" FontWeight="SemiBold"
                                           Margin="30"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>