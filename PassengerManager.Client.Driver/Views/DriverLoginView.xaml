<UserControl x:Class="PassengerManager.Client.Driver.Views.DriverLoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PassengerManager.Client.Driver.Views"
             xmlns:coreRes="clr-namespace:PassengerManager.Client.Core.Resources;assembly=PassengerManager.Client.Core"
             xmlns:driverRes="clr-namespace:PassengerManager.Client.Driver.Resources;assembly=PassengerManager.Client.Driver"
             mc:Ignorable="d" 
             Foreground="White"
             FontSize="24"
             d:DesignHeight="1080" d:DesignWidth="1920">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500" MaxHeight="800" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="6*"/>            
        </Grid.RowDefinitions>

        <!--- Info box -->
        <Grid Grid.Row="0">
            <TextBlock Text="{Binding PromptText}" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#AAAAAA" Margin="0,0,0,10"/>

            <Border Background="#CC0000" CornerRadius="8" Padding="15" Margin="0,10"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}"
                               FontSize="22" VerticalAlignment="Center" TextWrapping="Wrap"/>

                    <Button Grid.Column="1" Content="✕"
                            Style="{StaticResource CloseErrorButtonStyle}"
                            Command="{Binding DismissErrorCommand}"
                            VerticalAlignment="Top"
                            Margin="10,0,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <!--- Input circles -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding InputCircles}" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Ellipse Width="24" Height="24" Margin="10,0" Stroke="#007ACC" StrokeThickness="3">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="True">
                                        <Setter Property="Fill" Value="#007ACC"/>
                                    </DataTrigger>                                                 
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--- Numpad -->
        <Grid Grid.Row="2" Margin="0,20,0,0" IsEnabled="{Binding IsNumpadEnabled}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Grid.Column="0" Content="1" Style="{StaticResource NumpadButtonStyle}" Command="{Binding AddDigitCommand}" CommandParameter="1"/>
            <Button Grid.Row="0" Grid.Column="1" Content="2" Style="{StaticResource NumpadButtonStyle}" Command="{Binding AddDigitCommand}" CommandParameter="2"/>
            <Button Grid.Row="0" Grid.Column="2" Content="3" Style="{StaticResource NumpadButtonStyle}" Command="{Binding AddDigitCommand}" CommandParameter="3"/>

            <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{StaticResource NumpadButtonStyle}" Command="{Binding AddDigitCommand}" CommandParameter="4"/>
            <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{StaticResource NumpadButtonStyle}" Command="{Binding AddDigitCommand}" CommandParameter="5"/>
            <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{StaticResource NumpadButtonStyle}" Command="{Binding AddDigitCommand}" CommandParameter="6"/>

            <Button Grid.Row="2" Grid.Column="0" Content="7" Style="{StaticResource NumpadButtonStyle}" Command="{Binding AddDigitCommand}" CommandParameter="7"/>
            <Button Grid.Row="2" Grid.Column="1" Content="8" Style="{StaticResource NumpadButtonStyle}" Command="{Binding AddDigitCommand}" CommandParameter="8"/>
            <Button Grid.Row="2" Grid.Column="2" Content="9" Style="{StaticResource NumpadButtonStyle}" Command="{Binding AddDigitCommand}" CommandParameter="9"/>

            <Button Grid.Row="3" Grid.Column="1" Content="0" Style="{StaticResource NumpadButtonStyle}" Command="{Binding AddDigitCommand}" CommandParameter="0"/>
            <Button Grid.Row="3" Grid.Column="2" Content="⌫" Style="{StaticResource NumpadButtonStyle}" Command="{Binding RemoveDigitCommand}"/>
        </Grid>
    </Grid>
</UserControl>
