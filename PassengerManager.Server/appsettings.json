{
  "SystemProfile": "Small",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Critical",
      "Microsoft.EntityFrameworkCore.Update": "Critical",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=PassengerManagerDB;Username=postgres;Password=[SET_IN_USER_SECRETS]",
    "RabbitMQ": "localhost"
  },
  "JwtSettings": {
    "Issuer": "PassengerManagerServer",
    "Audience": "PassengerManagerClient",
    "Key": "INSERT_SECRET_KEY_HERE_MUST_BE_VERY_LONG_FOR_SECURITY_REASONS_AT_LEAST_32_CHARS",
    "GeneralExpiryMinutes": 480,
    "StaffExpiryMinutes": 480,
    "DriverExpiryMinutes": 720,
    "HardwareExpiryMinutes": 1440
  },
  "GtfsSettings": {
    "StaticDataUrl": "https://track.ua-gis.com/gtfs/lviv/static.zip",
    "StaticDataSyncIntervalHours": 24,
    "StaticDataAutoSyncEnabled": true,
    "VehicleDataUrl": "http://track.ua-gis.com/gtfs/lviv/vehicle_position",
    "VehicleDataAutoSyncEnabled": true,
    "VehicleDataSyncIntervalSeconds": 5,
    "TripDataUrl": "https://track.ua-gis.com/gtfs/lviv/trip_updates",
    "TripDataAutoSyncEnabled": true,
    "TripDataSyncIntervalSeconds": 15,
    "ChannelCapacity": 100000,
    "ArchiverBatchSize": 500,
    "ArchiverMaxWaitSeconds": 60,
    "RedisTtlSeconds": 60
  },
  "HttpSettings": {
    "GtfsClient": {
      "TimeoutSeconds": 10,
      "DnsRefreshMinutes": 5,
      "UserAgent": "PassengerManager/1.0"
    }
  },
  "TimeoutDefaults": {
    "StaticData": {
      "MaxRetries": 5,
      "RetryTimeoutSeconds": 10,
      "DownloadTimeoutSeconds": 300
    },
    "VehicleData": {
      "DownloadTimeoutSeconds": 5
    },
    "TripData": {
      "DownloadTimeoutSeconds": 15
    }
  },
  "AuthDefaults": {
    "Staff": {
      "MinPasswordLength": 8,
      "DefaultPasswordLength": 12,
      "MaxPasswordAgeDays": 90,
      "MaxFailedAttempts": 3,
      "LockoutDurationSeconds": 300,
      "RecentPasswordHistoryCount": 5
    },
    "Terminal": {
      "MinPasswordLength": 8,
      "DefaultPasswordLength": 8,
      "MaxPasswordAgeDays": 30,
      "MaxFailedAttempts": 1,
      "LockoutDurationSeconds": 30,
      "RecentPasswordHistoryCount": 5
    }
  },
  "MapConstraints": {
    "MaxKeyLength": 128,
    "Agency": {
      "MaxTimezoneLength": 50,
      "MaxPhoneLength": 50,
      "MaxLangLength": 10
    },
    "Route": {
      "MaxColorLength": 10,
      "MaxShortNameLength": 50
    },
    "Stop": {
      "MaxCodeLength": 50
    }
  }
}
